  Custom:Create("UIStroke", { Color = Color3.fromRGB(80,80,80), Thickness = 1 }, ApplyBtn)

  MakeDraggable(PickerTopBar, PickerGui)

  -- === State ===
  local H, S, V = Color3.toHSV(Default)
  local TempColor = Default
  local draggingSV = false
  local draggingHue = false
  local updatingFromInput = false

  local function ColorToHex(c)
    return string.format("#%02x%02x%02x",
      math.floor(c.R*255+0.5),
      math.floor(c.G*255+0.5),
      math.floor(c.B*255+0.5)
    )
  end

  local function UpdateVisuals()
    SVBox.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
    TempColor = Color3.fromHSV(H, S, V)
    PreviewNew.BackgroundColor3 = TempColor

    -- Fix cursor positions
    SVCursor.Position = UDim2.fromScale(S, 1 - V)
    HueCursor.Position = UDim2.new(0.5, 0, H, 0)

    if not updatingFromInput then
      updatingFromInput = true
      HexInput.Text   = ColorToHex(TempColor)
      RedInput.Text   = tostring(math.floor(TempColor.R*255+0.5))
      GreenInput.Text = tostring(math.floor(TempColor.G*255+0.5))
      BlueInput.Text  = tostring(math.floor(TempColor.B*255+0.5))
      updatingFromInput = false
    end
  end

  -- === SV drag ===
  SVInput.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      draggingSV = true
      S = math.clamp((inp.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
      V = 1 - math.clamp((inp.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
      UpdateVisuals()
    end
  end)
  SVInput.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      draggingSV = false
    end
  end)

  -- === Hue drag ===
  HueInput.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      draggingHue = true
      H = math.clamp((inp.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
      UpdateVisuals()
    end
  end)
  HueInput.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
      draggingHue = false
    end
  end)

  UserInputService.InputChanged:Connect(function(inp)
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    if not PickerGui.Visible then return end

    if draggingSV then
      S = math.clamp((inp.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
      V = 1 - math.clamp((inp.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
      UpdateVisuals()
    end
    if draggingHue then
      H = math.clamp((inp.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
      UpdateVisuals()
    end
  end)

  -- === Hex input ===
  HexInput.FocusLost:Connect(function()
    if updatingFromInput then return end
    local txt = HexInput.Text:gsub("#",""):gsub("%s","")
    if #txt == 6 then
      local r = tonumber(txt:sub(1,2), 16)
      local g = tonumber(txt:sub(3,4), 16)
      local b = tonumber(txt:sub(5,6), 16)
      if r and g and b then
        local c = Color3.fromRGB(r, g, b)
        H, S, V = Color3.toHSV(c)
        UpdateVisuals()
      end
    end
  end)

  -- === RGB inputs ===
  local function MakeRGBHandler(tb, channel)
    tb.FocusLost:Connect(function()
      if updatingFromInput then return end
      local n = tonumber(tb.Text)
      if n then
        n = math.clamp(math.floor(n), 0, 255)
        local r = math.floor(TempColor.R*255+0.5)
        local g = math.floor(TempColor.G*255+0.5)
        local b = math.floor(TempColor.B*255+0.5)
        if channel == "R" then r = n
        elseif channel == "G" then g = n
        elseif channel == "B" then b = n end
        local c = Color3.fromRGB(r, g, b)
        H, S, V = Color3.toHSV(c)
        UpdateVisuals()
      end
    end)
  end

  MakeRGBHandler(RedInput,   "R")
  MakeRGBHandler(GreenInput, "G")
  MakeRGBHandler(BlueInput,  "B")

  -- === Open / Close ===
  local function ClosePicker()
    PickerGui.Visible = false
    PickShadow.Visible = false
    draggingSV = false
    draggingHue = false
  end

  PreviewButton.Activated:Connect(function()
    if PickerGui.Visible then ClosePicker() return end
    PreviewOld.BackgroundColor3 = Funcs_ColorPicker.Value
    H, S, V = Color3.toHSV(Funcs_ColorPicker.Value)
    UpdateVisuals()
    PickerGui.Visible = true
    PickShadow.Visible = true
  end)

  ApplyBtn.Activated:Connect(function()
    CircleClick(ApplyBtn, Player:GetMouse().X, Player:GetMouse().Y)
    Funcs_ColorPicker.Value = TempColor
    PreviewButton.BackgroundColor3 = TempColor
    Callback(TempColor)
    ClosePicker()
  end)

  CancelBtn.Activated:Connect(function()
    CircleClick(CancelBtn, Player:GetMouse().X, Player:GetMouse().Y)
    ClosePicker()
  end)

  -- === Public API ===
  function Funcs_ColorPicker:Set(Value)
    Funcs_ColorPicker.Value = Value
    PreviewButton.BackgroundColor3 = Value
    H, S, V = Color3.toHSV(Value)
    TempColor = Value
    if PickerGui.Visible then
      PreviewOld.BackgroundColor3 = Value
      UpdateVisuals()
    end
    Callback(Value)
  end

  -- Init
  H, S, V = Color3.toHSV(Default)
  TempColor = Default
  PreviewOld.BackgroundColor3 = Default
  PreviewNew.BackgroundColor3 = Default
  UpdateVisuals()

  ItemCount += 1
  return Funcs_ColorPicker
end 

