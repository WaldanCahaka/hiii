                    Name = "SliderDraggable",
                }, SliderFrame)

        Custom:Create("UICorner", {}, SliderDraggable)

        local SliderCircle = Custom:Create("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    BackgroundColor3 = Custom.ColorRGB,
                    BorderColor3 = Color3.fromRGB(0, 0, 0),
